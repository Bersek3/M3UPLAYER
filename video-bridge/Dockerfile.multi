FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY video-bridge/server.js video-bridge/multi.js ./video-bridge/
COPY playlists/chile-sin-credenciales.m3u ./playlists/chile-sin-credenciales.m3u
USER node
ENV NODE_ENV=production BRIDGE_HOST=0.0.0.0
EXPOSE 10000
CMD ["node", "video-bridge/multi.js"]
