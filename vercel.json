{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "api/auth/*.js", "use": "@vercel/node" },
    { "src": "api/user/**/*.js", "use": "@vercel/node" },
    { "src": "api/proxy/*.js", "use": "@vercel/node" },
    { "src": "api/status.js", "use": "@vercel/node" },
    { "src": "api/channels.js", "use": "@vercel/node" },
    { "src": "server/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, Range"
      },
      "continue": true
    },
    { "src": "/api/user/playlist/(url|upload|confirm)", "dest": "/api/user/playlist/$1.js" },
    { "src": "/api/user/playlist/([^/]+)", "dest": "/api/user/playlist/[id].js?id=$1" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/server/public/index.html" },
    { "src": "/(.*)", "dest": "/server/public/$1" }
  ]
}
